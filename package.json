{
  "name": "well-actually",
  "version": "0.1.1",
  "private": true,
  "description": "Well, Actually — a browser extension that replaces \"AI\" with \"LLM\" as you read.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm lint:firefox",
    "check:firefox": "scripts/check-firefox.sh",
    "check:package": "scripts/check-package.sh",
    "lint:firefox": "web-ext lint --source-dir dist --warnings-as-errors",
    "package": "pnpm build && node package.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0"
  }
}
